{
	"name": "ketuk",
	"private": true,
	"workspaces": [
		"frontend",
		"backend",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"dev:fe": "bun run --filter frontend dev",
		"dev:be": "bun run --filter backend dev",
		"build:shared": "bun run --filter '@ketuk/shared' build",
		"build": "bun run build:shared && bun run --filter '*' build",
		"check": "bun run build:shared && bun run --filter '*' check",
		"lint": "biome check .",
		"format": "biome format --write .",
		"db:generate": "bun run --filter backend db:generate",
		"db:migrate": "bun run --filter backend db:migrate",
		"db:studio": "bun run --filter backend db:studio"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.4.1"
}
