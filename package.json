{
	"name": "ketuk",
	"private": true,
	"workspaces": [
		"frontend",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter frontend dev",
		"dev:fe": "bun run --filter frontend dev",
		"build:shared": "bun run --filter '@ketuk/shared' build",
		"build": "bun run build:shared && bun run --filter frontend build",
		"check": "bun run build:shared && bun run --filter frontend check",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.4.1"
}
